---
import Layout from '@/components/layout.astro';
import { source } from '@/lib/source';
import { Icon } from 'astro-icon/components';

const features = [
  {
    title: 'Why GPU-Passthrough?',
    icon: 'lucide:shield-check',
    description:
      "It's more secure and you don't need to install an OS on your computer. Everything runs in the virtual machine.",
  },
  {
    title: 'Free up space',
    icon: 'lucide:hard-drive',
    description:
      "You don't want to install two operating systems on your computer because it takes up space.",
  },
  {
    title: 'Fuck Windows',
    icon: 'lucide:monitor-x',
    description:
      'You hate Windows, but some software is more stable there than on GNU/Linux. (like DaVinci Resolve)',
  },
];

const sections = source.pageTree.children
  .filter((node) => node.type === 'folder')
  .map((folder) => ({
    title: folder.name,
    description: folder.description,
    href: (folder.index?.url ?? folder.children.find((c) => c.type === 'page')?.url) as string,
    count: folder.children.filter((c) => c.type === 'page').length,
  }));
---

<Layout
  title="GPU Passthrough Made Easy"
  description="Made GPU-Passthru easy, for everyone. Just follow our simple guide!"
>
  <header class="sticky top-0 z-10 border-b border-fd-border bg-fd-background/80 backdrop-blur">
    <nav class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-6">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <Icon name="lucide:cpu" class="size-5 text-fd-primary" />
        Passthru
      </a>
      <div class="flex-1"></div>
      <a href="/docs/intro" class="text-sm text-fd-muted-foreground hover:text-fd-foreground">Docs</a>
      <a
        href="https://github.com/UmmItKin/passthru"
        class="text-fd-muted-foreground hover:text-fd-foreground"
        aria-label="GitHub repository"><Icon name="simple-icons:github" class="size-5" /></a
      >
    </nav>
  </header>

  <main class="mx-auto w-full max-w-6xl flex-1 px-6">
    <!-- Hero -->
    <section class="relative flex flex-col items-center py-24 text-center sm:py-32">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 bg-[radial-gradient(ellipse_at_top,var(--color-fd-primary)/15,transparent_70%)]"
      >
      </div>
      <span
        class="mb-6 rounded-full border border-fd-border bg-fd-card px-3 py-1 text-xs text-fd-muted-foreground"
      >
        KVM · QEMU · libvirt · VFIO
      </span>
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-6xl">
        GPU Passthrough Made Easy
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-fd-muted-foreground text-balance">
        Pass a real GPU into a virtual machine — no dual boot, no vGPU. Follow the guide, step by
        step.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/docs/intro"
          class="rounded-full bg-fd-primary px-6 py-2.5 font-medium text-fd-primary-foreground transition-opacity hover:opacity-85"
        >
          Get Started
        </a>
        <a
          href="https://github.com/UmmItKin/passthru"
          class="flex items-center gap-2 rounded-full border border-fd-border px-6 py-2.5 font-medium transition-colors hover:bg-fd-accent"
        >
          <Icon name="simple-icons:github" class="size-4" />
          Star on GitHub
        </a>
      </div>
    </section>

    <!-- Why -->
    <section class="grid gap-6 pb-24 sm:grid-cols-3">
      {
        features.map((feature) => (
          <div class="flex flex-col items-center gap-3 rounded-2xl border border-fd-border bg-fd-card p-8 text-center transition-colors hover:border-fd-primary/40">
            <Icon name={feature.icon} class="size-12 text-fd-primary" />
            <h2 class="text-lg font-semibold">{feature.title}</h2>
            <p class="text-sm text-fd-muted-foreground">{feature.description}</p>
          </div>
        ))
      }
    </section>

    <!-- Guides -->
    <section class="pb-24">
      <h2 class="text-2xl font-semibold">Guides</h2>
      <p class="mt-2 text-fd-muted-foreground">Everything is split into small, followable steps.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          sections.map((section) => (
            <a
              href={section.href}
              class="group flex flex-col rounded-2xl border border-fd-border bg-fd-card p-6 transition-colors hover:border-fd-primary/40"
            >
              <h3 class="font-medium group-hover:text-fd-primary">{section.title}</h3>
              {section.description && (
                <p class="mt-2 text-sm text-fd-muted-foreground">{section.description}</p>
              )}
              <span class="mt-4 text-xs text-fd-muted-foreground">{section.count} pages</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="border-t border-fd-border py-8 text-center text-sm text-fd-muted-foreground">
    <a href="https://github.com/UmmItKin/passthru" class="hover:text-fd-foreground">Source code</a>
    <p class="mt-2">Copyright © {new Date().getFullYear()} passthru. Built with Fumadocs.</p>
  </footer>
</Layout>
